package views

type Instance struct {
  Title string
  Workdir string
  State string
  TailscaleURL string
  AppPort string
  ProxyPort string
  Status string
  Alive bool
}

templ HomePage(instances []Instance, discoveryError string) {
  <!doctype html>
  <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
      <title>Hub</title>
      <script type="module" src="/assets/datastar-v1.0.2.js"></script>
      <style>
        :root { font-family: ui-sans-serif, system-ui, sans-serif; color-scheme: light dark; }
        body { margin: 0; padding: 1.5rem; }
        main { max-width: 70rem; margin: 0 auto; }
        .servers { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); gap: .75rem; }
        .server { min-width: 0; border: 1px solid light-dark(#2563eb, #93c5fd); border-radius: .75rem; background: light-dark(#eff6ff, #172c46); color: light-dark(#1e40af, #bfdbfe); overflow: hidden; }
        .server.dev { border-color: light-dark(#15803d, #4ade80); background: light-dark(#f0fdf4, #133322); color: light-dark(#166534, #bbf7d0); }
        .server a, .server-content { display: block; box-sizing: border-box; height: 100%; padding: .85rem; color: inherit; text-decoration: none; }
        .server a:hover { background: light-dark(#dbeafe, #234365); }
        .server.dev a:hover { background: light-dark(#dcfce7, #1b4830); }
        .server a:focus-visible { outline: 3px solid currentColor; outline-offset: -3px; border-radius: .75rem; }
        .server-head { display: flex; align-items: start; justify-content: space-between; gap: .5rem; }
        .server h3 { font-size: 1.25rem; margin: 0 0 .5rem; overflow-wrap: anywhere; }
        .running-dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 50%; background: light-dark(#16a34a, #4ade80); vertical-align: middle; margin-right: .3rem; }
        .server-proxy-icon { width: 1.25rem; height: 1.25rem; vertical-align: middle; margin-left: .25rem; }
        .server-arrow { width: 1.75rem; height: 1.75rem; flex: none; }
        .server p { margin: .25rem 0; font-size: .85rem; }
        .port-number { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-weight: 700; padding: .05rem .25rem; border-radius: .25rem; background: light-dark(#dbeafe, #234365); }
        .server.dev .port-number { background: light-dark(#dcfce7, #1b4830); }
        .server.offline { opacity: .75; }
      </style>
    </head>
    <body>
      <main>
        <h1>Hub</h1>
        <button data-on:click="@get('/status')">Check server</button>
        @ServerStatus()
        <h2>Gust instances</h2>
        <button type="button" data-on:click="@get('/instances')" data-indicator:scanning data-attr:disabled="$scanning" data-text="$scanning ? 'Scanning…' : 'Rescan instances'">Rescan instances</button>
        @InstanceList(instances, discoveryError)
      </main>
    </body>
  </html>
}

templ InstanceList(instances []Instance, discoveryError string) {
  <div id="instance-list">
    if discoveryError != "" {
      <p role="status">{ discoveryError }</p>
    } else if len(instances) == 0 {
      <p>No Gust instances found.</p>
    } else {
      <ul class="servers">
        for _, instance := range instances {
          <li class={ "server", templ.KV("offline", !instance.Alive), templ.KV("dev", instance.ProxyPort != "") } title={ instance.Workdir }>
            if instance.TailscaleURL != "" {
              <a href={ instance.TailscaleURL }>
                @InstanceCardContent(instance, true)
              </a>
            } else {
              <div class="server-content">
                @InstanceCardContent(instance, false)
              </div>
            }
          </li>
        }
      </ul>
    }
  </div>
}

templ InstanceCardContent(instance Instance, linked bool) {
  <div class="server-head">
    <h3>
      if instance.State == "running" {
        <span class="running-dot" role="img" aria-label="Running"></span>
      }
      { instance.Title }
      if instance.ProxyPort != "" {
        <svg class="server-proxy-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" role="img" aria-label="Development proxy">
          <rect width="256" height="256" fill="none"/>
          <rect x="16" y="64" width="224" height="128" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
          <polyline points="144 96 120 96 120 160 144 160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
          <line x1="136" y1="128" x2="120" y2="128" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
          <polyline points="172 96 190 160 208 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
          <path d="M56,96h8a24,24,0,0,1,24,24v16a24,24,0,0,1-24,24H56a0,0,0,0,1,0,0V96A0,0,0,0,1,56,96Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
        </svg>
      }
    </h3>
    if linked {
      <svg class="server-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 19 19 5M8 5h11v11"/>
      </svg>
    }
  </div>
  if instance.State == "running" {
    <p>{ instance.Status }</p>
  } else {
    <p>{ instance.State } · { instance.Status }</p>
  }
  <p class="ports">
    App:
    if instance.AppPort != "" {
      <span class="port-number">{ instance.AppPort }</span>
    } else {
      —
    }
    · Proxy:
    if instance.ProxyPort != "" {
      <span class="port-number">{ instance.ProxyPort }</span>
    } else {
      —
    }
  </p>
}

templ ServerStatus() {
  <p id="server-status" role="status">Server status has not been checked.</p>
}

templ ServerStatusHealthy() {
  <p id="server-status" role="status">Server is healthy.</p>
}
