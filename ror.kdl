task build {
    cmd "git lfs install --local && git lfs pull && go build -o out/gust ./cmd/gust"
}

task dev:self {
    description "Watch Gust source, rebuild, and restart the docs/demo app"

    cmd "tools/dev-self.sh"
}

task demo:gust {
    description "Run the docs/demo instance with local Gust"

    cmd #"""
      cd docs/demo
      go run ../../cmd/gust \
        -TT \
        -e 'uv run server.py' \
        -h /health \
        --optin comments \
        --optin sounds \
        --exclude .venv
    """#
}
